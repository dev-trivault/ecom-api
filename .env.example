# ───────── Server ─────────
NODE_ENV=development
PORT=4000
# Interface to listen on. On a shared server behind Nginx use 127.0.0.1 so the port is not public.
HOST=0.0.0.0

# ───────── Database ─────────
# Local (npm run db:up):
DATABASE_URL="postgresql://ecom:ecom@localhost:5433/ecom?schema=public"
# Azure Database for PostgreSQL (production) - SSL is required:
# DATABASE_URL="postgresql://<user>:<url-encoded-password>@<server>.postgres.database.azure.com:5432/ecom?schema=public&sslmode=require"

# ───────── Auth ─────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Allow new businesses to sign up from the /register page.
# Set to false in production once your own account is created (until the SaaS launch).
ALLOW_REGISTRATION=true

# ───────── HTTP ─────────
# Comma-separated origins allowed to call the API directly from a browser.
# Not needed for the web app itself (it calls the API through its own /api proxy).
CORS_ORIGINS=http://localhost:3100
# Mark auth cookies Secure (HTTPS only). Leave empty to use true in production, false otherwise.
COOKIE_SECURE=
# Set to true when running behind a reverse proxy (Nginx, Vercel rewrites, Hostinger proxy).
TRUST_PROXY=false
# Serve Swagger UI at /docs
SWAGGER_ENABLED=true
