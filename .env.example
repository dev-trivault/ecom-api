# Local development settings for ecom-api.
#   cp .env.example .env      then set JWT_ACCESS_SECRET
# Production settings are in .env.production.example.

# ───────── Server ─────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# ───────── Database ─────────
# The Postgres container started by `npm run db:up`
DATABASE_URL="postgresql://ecom:ecom@localhost:5433/ecom?schema=public"

# ───────── Auth ─────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# How many phones / computers can be logged in at the same time. A further login is refused until one logs out.
MAX_LOGIN_DEVICES=3

# ───────── Email (password reset links) ─────────
# Address of the web app, used to build the link in password reset emails.
WEB_APP_URL=http://localhost:3100
# Mailpit, started by `npm run db:up`, catches every email. Read them at http://localhost:8025.
# Leave SMTP_HOST empty to turn "Forgot password?" off.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Ecom Manager <no-reply@ecom.local>"

# ───────── HTTP ─────────
# Comma-separated origins allowed to call the API directly from a browser.
# Not needed for the web app itself (it calls the API through its own /api proxy).
CORS_ORIGINS=http://localhost:3100
# Mark auth cookies Secure (HTTPS only). Leave empty to use true in production, false otherwise.
COOKIE_SECURE=
# Set to true when running behind a reverse proxy (Nginx, Vercel rewrites).
TRUST_PROXY=false
# Serve Swagger UI at http://localhost:4000/docs
SWAGGER_ENABLED=true
