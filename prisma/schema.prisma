// Database schema for the Ecom business platform.
//
// Ground rules (see /CLAUDE.md for the full list):
// - Every business table carries `organizationId`. That column is the tenant boundary
//   and every query must filter by it, so the app can become multi-tenant SaaS later.
// - Postgres names are snake_case: tables plural via @@map, multi-word fields via @map.
// - Every table has createdAt, createdById (created_by), updatedAt, updatedById (updated_by).
//   The by-columns are stamped by src/prisma/audit.extension.ts.
// - Stock is never edited directly. Every change is a row in `stock_movements` (the
//   ledger), and `stock_levels` is a running total kept in sync in the same DB transaction.
// - Posted documents (purchases, dispatches, returns) are never edited or deleted.
//   They are cancelled, which writes reversing movements.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  OWNER // full access, including billing and deleting the business (future)
  ADMIN // full access to data and team management
  MANAGER // can create and cancel entries, manage catalog
  STAFF // can create entries (purchase / packing / return), read-only elsewhere
}

enum DocumentStatus {
  COMPLETED
  CANCELLED
}

enum StockMovementType {
  OPENING // stock that existed before the SKU was entered in the system
  PURCHASE // stock in from a supplier
  DISPATCH // stock out when a parcel is packed for an order
  RETURN // good-condition return put back into sellable stock
  ADJUSTMENT // manual correction after a physical count, damage, loss etc.
  PURCHASE_CANCELLED // reversal of a cancelled purchase
  DISPATCH_CANCELLED // reversal of a cancelled packing entry
  RETURN_CANCELLED // reversal of a cancelled return
}

enum ReturnType {
  RTO // Return To Origin: courier could not deliver, parcel came back
  CUSTOMER_RETURN // customer received the order and returned it
}

enum ReturnCondition {
  GOOD // goes back to sellable stock
  DAMAGED // not restocked
  WRONG_ITEM // customer sent back a different product, not restocked
  MISSING // item missing from the returned parcel, not restocked
}

// ──────────────────────── Tenancy & Auth ────────────────────────

model Organization {
  id                     String   @id @default(uuid(7)) @db.Uuid
  name                   String
  slug                   String   @unique
  gstin                  String?
  phone                  String?
  email                  String?
  address                String?
  timezone               String   @default("Asia/Kolkata")
  currency               String   @default("INR")
  isNegativeStockAllowed Boolean  @default(false) @map("is_negative_stock_allowed")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")
  createdById            String?  @map("created_by") @db.Uuid
  updatedById            String?  @map("updated_by") @db.Uuid

  memberships    Membership[]
  sessions       Session[]
  products       Product[]
  variants       ProductVariant[]
  warehouses     Warehouse[]
  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  suppliers      Supplier[]
  salesChannels  SalesChannel[]
  purchases      Purchase[]
  dispatches     Dispatch[]
  salesReturns   SalesReturn[]
  sequences      DocumentSequence[]

  @@map("organizations")
}

model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  email        String    @unique
  name         String
  phone        String?
  passwordHash String    @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  createdById  String?   @map("created_by") @db.Uuid
  updatedById  String?   @map("updated_by") @db.Uuid

  memberships       Membership[]
  sessions          Session[]
  stockMovements    StockMovement[]
  purchasesCreated  Purchase[]      @relation("PurchaseCreatedBy")
  dispatchesCreated Dispatch[]      @relation("DispatchCreatedBy")
  returnsCreated    SalesReturn[]   @relation("ReturnCreatedBy")

  @@map("users")
}

model Membership {
  id             String   @id @default(uuid(7)) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  role           Role     @default(STAFF)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdById    String?  @map("created_by") @db.Uuid
  updatedById    String?  @map("updated_by") @db.Uuid

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

// One row per logged-in device. The refresh token itself is never stored, only its hash.
model Session {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  lastUsedAt       DateTime  @default(now()) @map("last_used_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  createdById      String?   @map("created_by") @db.Uuid
  updatedAt        DateTime  @updatedAt @map("updated_at")
  updatedById      String?   @map("updated_by") @db.Uuid

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ─────────────────────────── Catalog ───────────────────────────

// A product is what you list (e.g. "Cotton Kurta"). The thing you actually stock and
// sell is a variant / SKU (e.g. "KURTA-RED-M"). Products without sizes or colours
// simply have a single variant.
model Product {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  description    String?
  category       String?
  brand          String?
  hsnCode        String?  @map("hsn_code")
  gstRate        Decimal? @map("gst_rate") @db.Decimal(5, 2)
  imageUrl       String?  @map("image_url")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdById    String?  @map("created_by") @db.Uuid
  updatedById    String?  @map("updated_by") @db.Uuid

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  variants     ProductVariant[]

  @@index([organizationId, name])
  @@index([organizationId, category])
  @@map("products")
}

model ProductVariant {
  id                String   @id @default(uuid(7)) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  sku               String // stored upper-case and trimmed, unique per organization
  size              String?
  color             String?
  barcode           String?
  costPrice         Decimal  @default(0) @map("cost_price") @db.Decimal(12, 2) // last purchase price
  sellingPrice      Decimal  @default(0) @map("selling_price") @db.Decimal(12, 2)
  mrp               Decimal? @db.Decimal(12, 2)
  lowStockThreshold Int      @default(5) @map("low_stock_threshold")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  createdById       String?  @map("created_by") @db.Uuid
  updatedById       String?  @map("updated_by") @db.Uuid

  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockLevels   StockLevel[]
  movements     StockMovement[]
  purchaseItems PurchaseItem[]
  dispatchItems DispatchItem[]
  returnItems   ReturnItem[]

  @@unique([organizationId, sku])
  @@index([productId])
  @@index([organizationId, barcode])
  @@map("product_variants")
}

// ────────────────────────── Inventory ──────────────────────────

model Warehouse {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  address        String?
  isDefault      Boolean  @default(false) @map("is_default")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdById    String?  @map("created_by") @db.Uuid
  updatedById    String?  @map("updated_by") @db.Uuid

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockLevels  StockLevel[]
  movements    StockMovement[]
  purchases    Purchase[]
  dispatches   Dispatch[]
  salesReturns SalesReturn[]

  @@unique([organizationId, name])
  @@map("warehouses")
}

// Current quantity of one SKU in one warehouse. Only StockService may write to this table.
model StockLevel {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  variantId      String   @map("variant_id") @db.Uuid
  warehouseId    String   @map("warehouse_id") @db.Uuid
  quantity       Int      @default(0)
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdAt      DateTime @default(now()) @map("created_at")
  createdById    String?  @map("created_by") @db.Uuid
  updatedById    String?  @map("updated_by") @db.Uuid

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse    Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([variantId, warehouseId])
  @@index([organizationId])
  @@map("stock_levels")
}

// The stock ledger. Append-only: rows are never updated or deleted.
model StockMovement {
  id             String            @id @default(uuid(7)) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  variantId      String            @map("variant_id") @db.Uuid
  warehouseId    String            @map("warehouse_id") @db.Uuid
  type           StockMovementType
  quantity       Int // signed: positive = stock in, negative = stock out
  balanceAfter   Int               @map("balance_after") // stock level of this SKU in this warehouse right after the movement
  unitCost       Decimal?          @map("unit_cost") @db.Decimal(12, 2)
  purchaseId     String?           @map("purchase_id") @db.Uuid
  dispatchId     String?           @map("dispatch_id") @db.Uuid
  salesReturnId  String?           @map("sales_return_id") @db.Uuid
  note           String?
  createdById    String?           @map("created_by") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  updatedById    String?           @map("updated_by") @db.Uuid

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse    Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  purchase     Purchase?      @relation(fields: [purchaseId], references: [id])
  dispatch     Dispatch?      @relation(fields: [dispatchId], references: [id])
  salesReturn  SalesReturn?   @relation(fields: [salesReturnId], references: [id])
  createdBy    User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([variantId, createdAt])
  @@index([purchaseId])
  @@index([dispatchId])
  @@index([salesReturnId])
  @@map("stock_movements")
}

// Per-organization counters for human-friendly document numbers (PUR-00001, PCK-00001 ...).
model DocumentSequence {
  organizationId String   @map("organization_id") @db.Uuid
  key            String
  lastValue      Int      @default(0) @map("last_value")
  createdAt      DateTime @default(now()) @map("created_at")
  createdById    String?  @map("created_by") @db.Uuid
  updatedAt      DateTime @updatedAt @map("updated_at")
  updatedById    String?  @map("updated_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, key])
  @@map("document_sequences")
}

// ───────────────────────── Purchasing ─────────────────────────

model Supplier {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  contactPerson  String?  @map("contact_person")
  phone          String?
  email          String?
  gstin          String?
  address        String?
  city           String?
  notes          String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdById    String?  @map("created_by") @db.Uuid
  updatedById    String?  @map("updated_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchases    Purchase[]

  @@unique([organizationId, name])
  @@map("suppliers")
}

// "Stock In": wholesale purchase entry.
model Purchase {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  number         String
  supplierId     String?        @map("supplier_id") @db.Uuid
  warehouseId    String         @map("warehouse_id") @db.Uuid
  invoiceNumber  String?        @map("invoice_number")
  purchaseDate   DateTime       @map("purchase_date") @db.Date
  notes          String?
  totalQuantity  Int            @map("total_quantity")
  totalAmount    Decimal        @map("total_amount") @db.Decimal(14, 2)
  status         DocumentStatus @default(COMPLETED)
  createdById    String?        @map("created_by") @db.Uuid
  cancelledById  String?        @map("cancelled_by_id") @db.Uuid
  cancelledAt    DateTime?      @map("cancelled_at")
  cancelReason   String?        @map("cancel_reason")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  updatedById    String?        @map("updated_by") @db.Uuid

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier     Supplier?       @relation(fields: [supplierId], references: [id])
  warehouse    Warehouse       @relation(fields: [warehouseId], references: [id])
  createdBy    User?           @relation("PurchaseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items        PurchaseItem[]
  movements    StockMovement[]

  @@unique([organizationId, number])
  @@index([organizationId, purchaseDate])
  @@index([supplierId])
  @@map("purchases")
}

model PurchaseItem {
  id          String   @id @default(uuid(7)) @db.Uuid
  purchaseId  String   @map("purchase_id") @db.Uuid
  variantId   String   @map("variant_id") @db.Uuid
  quantity    Int
  unitCost    Decimal  @map("unit_cost") @db.Decimal(12, 2)
  lineTotal   Decimal  @map("line_total") @db.Decimal(14, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  createdById String?  @map("created_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String?  @map("updated_by") @db.Uuid

  purchase Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id])

  @@index([purchaseId])
  @@index([variantId])
  @@map("purchase_items")
}

// ─────────────────────────── Selling ───────────────────────────

// Meesho, Flipkart, Amazon, Myntra ... stored as rows (not an enum) so each business,
// and later each SaaS tenant, can add its own channels.
model SalesChannel {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  code           String // upper-case short code, e.g. MEESHO
  color          String? // hex colour used for the channel badge in the UI
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdById    String?  @map("created_by") @db.Uuid
  updatedById    String?  @map("updated_by") @db.Uuid

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dispatches   Dispatch[]
  salesReturns SalesReturn[]

  @@unique([organizationId, code])
  @@map("sales_channels")
}

// "Packing" in the UI: parcels packed for marketplace orders. Stock goes out.
model Dispatch {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  number         String
  channelId      String         @map("channel_id") @db.Uuid
  warehouseId    String         @map("warehouse_id") @db.Uuid
  orderNumber    String?        @map("order_number")
  trackingNumber String?        @map("tracking_number")
  dispatchDate   DateTime       @map("dispatch_date") @db.Date
  notes          String?
  totalQuantity  Int            @map("total_quantity")
  status         DocumentStatus @default(COMPLETED)
  createdById    String?        @map("created_by") @db.Uuid
  cancelledById  String?        @map("cancelled_by_id") @db.Uuid
  cancelledAt    DateTime?      @map("cancelled_at")
  cancelReason   String?        @map("cancel_reason")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  updatedById    String?        @map("updated_by") @db.Uuid

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel      SalesChannel    @relation(fields: [channelId], references: [id])
  warehouse    Warehouse       @relation(fields: [warehouseId], references: [id])
  createdBy    User?           @relation("DispatchCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items        DispatchItem[]
  movements    StockMovement[]
  salesReturns SalesReturn[]

  @@unique([organizationId, number])
  @@index([organizationId, dispatchDate])
  @@index([organizationId, orderNumber])
  @@index([channelId])
  @@map("dispatches")
}

model DispatchItem {
  id          String   @id @default(uuid(7)) @db.Uuid
  dispatchId  String   @map("dispatch_id") @db.Uuid
  variantId   String   @map("variant_id") @db.Uuid
  quantity    Int
  createdAt   DateTime @default(now()) @map("created_at")
  createdById String?  @map("created_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String?  @map("updated_by") @db.Uuid

  dispatch Dispatch       @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id])

  @@index([dispatchId])
  @@index([variantId])
  @@map("dispatch_items")
}

// "Returns" in the UI. Only items in GOOD condition go back to stock.
model SalesReturn {
  id                String         @id @default(uuid(7)) @db.Uuid
  organizationId    String         @map("organization_id") @db.Uuid
  number            String
  channelId         String         @map("channel_id") @db.Uuid
  warehouseId       String         @map("warehouse_id") @db.Uuid
  dispatchId        String?        @map("dispatch_id") @db.Uuid // original packing entry, when known
  type              ReturnType
  orderNumber       String?        @map("order_number")
  trackingNumber    String?        @map("tracking_number")
  returnDate        DateTime       @map("return_date") @db.Date
  notes             String?
  totalQuantity     Int            @map("total_quantity")
  restockedQuantity Int            @map("restocked_quantity")
  status            DocumentStatus @default(COMPLETED)
  createdById       String?        @map("created_by") @db.Uuid
  cancelledById     String?        @map("cancelled_by_id") @db.Uuid
  cancelledAt       DateTime?      @map("cancelled_at")
  cancelReason      String?        @map("cancel_reason")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  updatedById       String?        @map("updated_by") @db.Uuid

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel      SalesChannel    @relation(fields: [channelId], references: [id])
  warehouse    Warehouse       @relation(fields: [warehouseId], references: [id])
  dispatch     Dispatch?       @relation(fields: [dispatchId], references: [id])
  createdBy    User?           @relation("ReturnCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items        ReturnItem[]
  movements    StockMovement[]

  @@unique([organizationId, number])
  @@index([organizationId, returnDate])
  @@index([organizationId, orderNumber])
  @@index([channelId])
  @@map("sales_returns")
}

model ReturnItem {
  id            String          @id @default(uuid(7)) @db.Uuid
  salesReturnId String          @map("sales_return_id") @db.Uuid
  variantId     String          @map("variant_id") @db.Uuid
  quantity      Int
  condition     ReturnCondition @default(GOOD)
  createdAt     DateTime        @default(now()) @map("created_at")
  createdById   String?         @map("created_by") @db.Uuid
  updatedAt     DateTime        @updatedAt @map("updated_at")
  updatedById   String?         @map("updated_by") @db.Uuid

  salesReturn SalesReturn    @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id])

  @@index([salesReturnId])
  @@index([variantId])
  @@map("return_items")
}
