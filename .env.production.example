# Production settings for ecom-api. On the server they live in /srv/ecom/shared/ecom-api.env, never in the repo:
#   cp /srv/ecom/repo/.env.production.example /srv/ecom/shared/ecom-api.env
#   chmod 600 /srv/ecom/shared/ecom-api.env
#   nano /srv/ecom/shared/ecom-api.env      replace every <...> and every yourstore.in
# After changing the file on a running server: pm2 reload ecom-api

# ───────── Server ─────────
NODE_ENV=production
PORT=4000
# Only Nginx on the same server can reach the API; port 4000 is never public.
HOST=127.0.0.1

# ───────── Database ─────────
# Azure Database for PostgreSQL; SSL is required. URL-encode special characters in the password (@ = %40, # = %23).
DATABASE_URL="postgresql://ecomadmin:<url-encoded-password>@ecom-db.postgres.database.azure.com:5432/ecom?schema=public&sslmode=require"

# ───────── Auth ─────────
# A new random value, never the local one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=<new random value>
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# How many phones / computers can be logged in at the same time. A further login is refused until one logs out.
MAX_LOGIN_DEVICES=3

# ───────── Email (password reset links) ─────────
# The web app's https address (Vercel domain or your own). Required: the API does not start without it.
WEB_APP_URL=https://app.yourstore.in
# The mailbox that sends "Forgot password?" emails. Leave SMTP_HOST empty to turn the feature off.
# Port 465 needs SMTP_SECURE=true, port 587 needs SMTP_SECURE=false.
# Hostinger email:
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@yourstore.in
SMTP_PASSWORD=<mailbox password>
MAIL_FROM="Your Store <no-reply@yourstore.in>"
# Gmail instead (turn on 2-step verification, then create an app password at myaccount.google.com/apppasswords):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=yourstore@gmail.com
# SMTP_PASSWORD=<16-letter app password>
# MAIL_FROM="Your Store <yourstore@gmail.com>"

# ───────── HTTP ─────────
# Empty: the web app calls the API through its own /api proxy, so no browser origin needs CORS.
CORS_ORIGINS=
# Empty: cookies are Secure automatically in production.
COOKIE_SECURE=
# Requests arrive through Vercel and Nginx.
TRUST_PROXY=true
# true only if you want API docs at https://api.yourstore.in/docs
SWAGGER_ENABLED=false
